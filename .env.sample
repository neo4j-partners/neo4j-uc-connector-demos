# neo4j-uc-connector-demos - Configuration
# Copy to .env and fill in your values:
#   cp .env.sample .env

# =============================================================================
# databricks-job-runner core keys (validation/ suite)
# =============================================================================

# CLI profile name. Leave empty to use Databricks SDK unified auth.
DATABRICKS_PROFILE=

# Compute mode: cluster (default) or serverless.
DATABRICKS_COMPUTE_MODE=cluster

# Existing all-purpose cluster ID. Required only when DATABRICKS_COMPUTE_MODE=cluster.
DATABRICKS_CLUSTER_ID=

# Serverless environment version. Used only when DATABRICKS_COMPUTE_MODE=serverless.
DATABRICKS_SERVERLESS_ENV_VERSION=3

# Remote workspace path where validation scripts are uploaded.
DATABRICKS_WORKSPACE_DIR=/Users/<your-email>/neo4j-uc-connector-demos

# Databricks secret scope. Must match SECRET_KEYS in validation/cli/__init__.py.
DATABRICKS_SECRET_SCOPE=neo4j-uc-demos

# =============================================================================
# Neo4j Aura credentials
# =============================================================================
# These are stored as Databricks secrets and never passed as plaintext params.
# Run ./create_secrets.sh to provision the secret scope from these values.

# Neo4j host without protocol prefix.
# Example: for "neo4j+s://example.databases.neo4j.io" use "example.databases.neo4j.io".
# NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io is also supported.
NEO4J_HOST=<instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# =============================================================================
# Unity Catalog JDBC connection
# =============================================================================

UC_CONNECTION_NAME=sample_neo4j_jdbc_connection
JDBC_JAR_PATH=/Volumes/<catalog>/<schema>/<volume>/neo4j-unity-catalog-connector.jar

# UC Volume holding the aircraft digital twin CSV files. Used by
# getting-started/upload_data.sh and run_00_load_graph.py. Often the same
# volume that hosts JDBC_JAR_PATH.
UC_CATALOG=<catalog>
UC_SCHEMA=neo4j_getting_started
UC_VOLUME=aircraft_data

# =============================================================================
# Lakehouse configuration
# =============================================================================

# Catalog and schema containing the Delta tables: aircraft, systems, sensors,
# and sensor_readings.
LAKEHOUSE_CATALOG=
LAKEHOUSE_SCHEMA=lakehouse

# =============================================================================
# Metadata sync configuration
# =============================================================================

# Target catalog for materialized Neo4j tables.
METADATA_CATALOG=neo4j_metadata
NODES_SCHEMA=nodes
RELATIONSHIPS_SCHEMA=relationships

# Optional principal for validate_metadata.sh to grant
# CREATE_EXTERNAL_METADATA to. Leave empty to grant to the current workspace user.
METADATA_GRANT_PRINCIPAL=
