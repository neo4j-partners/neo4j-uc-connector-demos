# direct-jdbc-validation - Local Neo4j JDBC configuration
#
# Copy to .env and fill in your values, or export the same variables in your
# shell before running Maven.

# Full Neo4j URI. Aura usually uses neo4j+s://<instance>.databases.neo4j.io.
NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io

# Alternatively, omit NEO4J_URI and set NEO4J_HOST to the host only.
# NEO4J_HOST=<instance>.databases.neo4j.io

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
