#!/usr/bin/env bash
set -euo pipefail

MAVEN_VERSION="${MAVEN_VERSION:-3.9.11}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAVEN_CACHE_DIR="${MAVEN_CACHE_DIR:-$SCRIPT_DIR/.maven}"
MAVEN_DIST_DIR="$MAVEN_CACHE_DIR/apache-maven-$MAVEN_VERSION"
MAVEN_ARCHIVE="$MAVEN_CACHE_DIR/apache-maven-$MAVEN_VERSION-bin.tar.gz"
MAVEN_URL="${MAVEN_URL:-https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz}"
MAVEN_REPO_LOCAL="${MAVEN_REPO_LOCAL:-$MAVEN_CACHE_DIR/repository}"

if [[ ! -x "$MAVEN_DIST_DIR/bin/mvn" ]]; then
    mkdir -p "$MAVEN_CACHE_DIR"
    if [[ ! -f "$MAVEN_ARCHIVE" ]]; then
        echo "Downloading Apache Maven $MAVEN_VERSION..."
        curl -fsSL "$MAVEN_URL" -o "$MAVEN_ARCHIVE"
    fi
    tar -xzf "$MAVEN_ARCHIVE" -C "$MAVEN_CACHE_DIR"
fi

exec "$MAVEN_DIST_DIR/bin/mvn" -Dmaven.repo.local="$MAVEN_REPO_LOCAL" "$@"
